+/// The command to run in a newly opened window. See the `new_window_with_command`
+/// action.
+pub const NewWindowCommand = struct {
+    /// The command line to run. This is not null-terminated; use `len`.
+    /// It is owned by the configuration that produced the keybinding, so it
+    /// is only valid for the duration of the action call.
+    command: []const u8,
+
+    // Sync with: ghostty_action_new_window_command_s
+    pub const C = extern struct {
+        command: [*]const u8,
+        len: usize,
+    };
+
+    pub fn cval(self: NewWindowCommand) C {
+        return .{
+            .command = self.command.ptr,
+            .len = self.command.len,
+        };
+    }
+};
+
 /// sync with ghostty_action_close_tab_mode_e in ghostty.h
 pub const CloseTabMode = enum(c_int) {
     /// Close the current tab.
diff --git a/src/apprt/gtk/class/application.zig b/src/apprt/gtk/class/application.zig
index 7804366f5..4bf056fc2 100644
--- a/src/apprt/gtk/class/application.zig
+++ b/src/apprt/gtk/class/application.zig
@@ -738,6 +738,26 @@ pub const Application = extern struct {
                 .none,
             ),
 
+            .new_window_with_command => {
+                // `Command.shell` needs a sentinel-terminated string but the
+                // keybinding gives us a plain slice. `newWindow` copies what
+                // it needs before returning (same as `actionNewWindow`), so a
+                // temporary allocation is enough.
+                var arena: std.heap.ArenaAllocator = .init(self.core().alloc);
+                defer arena.deinit();
+
+                try Action.newWindow(
+                    self,
+                    switch (target) {
+                        .app => null,
+                        .surface => |v| v,
+                    },
+                    .{ .command = .{
+                        .shell = try arena.allocator().dupeZ(u8, value.command),
+                    } },
+                );
+            },
+
             .open_config => return Action.openConfig(self),
 
             .open_url => Action.openUrl(self, value),
