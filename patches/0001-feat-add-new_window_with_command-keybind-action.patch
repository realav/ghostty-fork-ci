@@ -77,6 +77,20 @@ extension Ghostty.Action {
         }
     }
 
+    struct NewWindowCommand {
+        /// The command to run in the new window's first surface.
+        let command: String
+
+        init(c: ghostty_action_new_window_command_s) {
+            if let commandCString = c.command {
+                let data = Data(bytes: commandCString, count: Int(c.len))
+                self.command = String(data: data, encoding: .utf8) ?? ""
+            } else {
+                self.command = ""
+            }
+        }
+    }
+
     struct ProgressReport {
         enum State {
             case remove
diff --git a/macos/Sources/Ghostty/Ghostty.App.swift b/macos/Sources/Ghostty/Ghostty.App.swift
index 1e02c8c57..1a9d728d4 100644
--- a/macos/Sources/Ghostty/Ghostty.App.swift
+++ b/macos/Sources/Ghostty/Ghostty.App.swift
@@ -502,6 +502,15 @@ extension Ghostty {
             case GHOSTTY_ACTION_NEW_WINDOW:
                 newWindow(app, target: target)
 
+            case GHOSTTY_ACTION_NEW_WINDOW_WITH_COMMAND:
+                newWindow(
+                    app,
+                    target: target,
+                    command: Ghostty.Action.NewWindowCommand(
+                        c: action.action.new_window_with_command
+                    ).command
+                )
+
             case GHOSTTY_ACTION_NEW_TAB:
                 newTab(app, target: target)
 
@@ -827,23 +836,44 @@ extension Ghostty {
             return true
         }
 
-        private static func newWindow(_ app: ghostty_app_t, target: ghostty_target_s) {
+        /// Open a new window. If `command` is non-empty, the new window's first
+        /// surface runs that command instead of the configured `command`.
+        private static func newWindow(
+            _ app: ghostty_app_t,
+            target: ghostty_target_s,
+            command: String = ""
+        ) {
             switch target.tag {
             case GHOSTTY_TARGET_APP:
+                // With no parent surface there's nothing to inherit, so we only
+                // need a config at all when we're overriding the command.
+                var userInfo: [String: Any] = [:]
+                if !command.isEmpty {
+                    var config = SurfaceConfiguration()
+                    config.command = command
+                    userInfo[Notification.NewSurfaceConfigKey] = config
+                }
+
                 NotificationCenter.default.post(
                     name: Notification.ghosttyNewWindow,
                     object: nil,
-                    userInfo: [:]
+                    userInfo: userInfo
                 )
 
             case GHOSTTY_TARGET_SURFACE:
                 guard let surface = target.target.surface else { return }
                 guard let surfaceView = self.surfaceView(from: surface) else { return }
+                var config = SurfaceConfiguration(
+                    from: ghostty_surface_inherited_config(surface, GHOSTTY_SURFACE_CONTEXT_WINDOW))
+                if !command.isEmpty {
+                    config.command = command
+                }
+
                 NotificationCenter.default.post(
                     name: Notification.ghosttyNewWindow,
                     object: surfaceView,
                     userInfo: [
-                        Notification.NewSurfaceConfigKey: SurfaceConfiguration(from: ghostty_surface_inherited_config(surface, GHOSTTY_SURFACE_CONTEXT_WINDOW)),
+                        Notification.NewSurfaceConfigKey: config,
                     ]
                 )
 
diff --git a/src/App.zig b/src/App.zig
index 28bbd83f1..ad016376c 100644
--- a/src/App.zig
+++ b/src/App.zig
@@ -323,6 +323,17 @@ pub fn newWindow(self: *App, rt_app: *apprt.App, msg: Message.NewWindow) !void {
         break :target .app;
     };
 
+    // A command override needs a different action so the apprt can pass the
+    // command through to the new surface's configuration.
+    if (msg.command.len > 0) {
+        _ = try rt_app.performAction(
+            target,
+            .new_window_with_command,
+            .{ .command = msg.command },
+        );
+        return;
+    }
+
     _ = try rt_app.performAction(
         target,
         .new_window,
@@ -451,6 +462,10 @@ pub fn performAction(
         .ignore => {},
         .quit => _ = try rt_app.performAction(.app, .quit, {}),
         .new_window => _ = try self.newWindow(rt_app, .{ .parent = null }),
+        .new_window_with_command => |command| _ = try self.newWindow(rt_app, .{
+            .parent = null,
+            .command = command,
+        }),
         .open_config => _ = try rt_app.performAction(.app, .open_config, {}),
         .reload_config => _ = try rt_app.performAction(.app, .reload_config, .{}),
         .close_all_windows => _ = try rt_app.performAction(.app, .close_all_windows, {}),
@@ -580,6 +595,10 @@ pub const Message = union(enum) {
     const NewWindow = struct {
         /// The parent surface
         parent: ?*Surface = null,
+
+        /// If set, the new window's first surface runs this command instead
+        /// of the configured `command`. Empty means "use the default".
+        command: []const u8 = "",
     };
 };
 
