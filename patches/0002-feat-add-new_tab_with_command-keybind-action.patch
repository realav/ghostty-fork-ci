+++ b/macos/Sources/Ghostty/Ghostty.App.swift
@@ -506,11 +506,20 @@ extension Ghostty {
                 newWindow(
                     app,
                     target: target,
-                    command: Ghostty.Action.NewWindowCommand(
+                    command: Ghostty.Action.CommandOverride(
                         c: action.action.new_window_with_command
                     ).command
                 )
 
+            case GHOSTTY_ACTION_NEW_TAB_WITH_COMMAND:
+                newTab(
+                    app,
+                    target: target,
+                    command: Ghostty.Action.CommandOverride(
+                        c: action.action.new_tab_with_command
+                    ).command
+                )
+
             case GHOSTTY_ACTION_NEW_TAB:
                 newTab(app, target: target)
 
@@ -882,13 +891,28 @@ extension Ghostty {
             }
         }
 
-        private static func newTab(_ app: ghostty_app_t, target: ghostty_target_s) {
+        /// Open a new tab. If `command` is non-empty, the new tab's surface runs
+        /// that command instead of the configured `command`.
+        private static func newTab(
+            _ app: ghostty_app_t,
+            target: ghostty_target_s,
+            command: String = ""
+        ) {
             switch target.tag {
             case GHOSTTY_TARGET_APP:
+                // With no parent surface there's nothing to inherit, so we only
+                // need a config at all when we're overriding the command.
+                var userInfo: [String: Any] = [:]
+                if !command.isEmpty {
+                    var config = SurfaceConfiguration()
+                    config.command = command
+                    userInfo[Notification.NewSurfaceConfigKey] = config
+                }
+
                 NotificationCenter.default.post(
                     name: Notification.ghosttyNewTab,
                     object: nil,
-                    userInfo: [:]
+                    userInfo: userInfo
                 )
 
             case GHOSTTY_TARGET_SURFACE:
@@ -905,11 +929,17 @@ extension Ghostty {
                     return
                 }
 
+                var config = SurfaceConfiguration(
+                    from: ghostty_surface_inherited_config(surface, GHOSTTY_SURFACE_CONTEXT_TAB))
+                if !command.isEmpty {
+                    config.command = command
+                }
+
                 NotificationCenter.default.post(
                     name: Notification.ghosttyNewTab,
                     object: surfaceView,
                     userInfo: [
-                        Notification.NewSurfaceConfigKey: SurfaceConfiguration(from: ghostty_surface_inherited_config(surface, GHOSTTY_SURFACE_CONTEXT_TAB)),
+                        Notification.NewSurfaceConfigKey: config,
                     ]
                 )
 
